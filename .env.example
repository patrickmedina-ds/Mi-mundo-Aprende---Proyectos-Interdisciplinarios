# Mi Mundo Aprende — variables de entorno de ejemplo
# Copia este archivo a `.env.local` y completa los valores. Nunca subas `.env.local`.

# La app web (Vite + React) NO necesita variables: guarda todo en localStorage.
# Las siguientes solo las usa el script offline de contenido:
#   scripts/generate_narrative_variants.py

# Cadena de conexión PostgreSQL (esquema en db/migrations/)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/mi_mundo_aprende

# Clave de API para generar variantes narrativas (quedan en PENDING_TEACHER_REVIEW)
OPENAI_API_KEY=

# Modelo a usar (opcional; por defecto gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
